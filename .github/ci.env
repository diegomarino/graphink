# Single place for repository- and toolchain-specific CI values.
# Plain KEY=value lines only: workflows append this file to $GITHUB_ENV and the
# scripts in .github/scripts source it. No secrets belong here.

# Repository identity (used in docs, release notes and checks, never for auth).
REPO_SLUG=diegomarino/graphink
PAGES_URL=https://diegomarino.github.io/graphink/
APP_NAME=Graphink

# Toolchain recorded in docs/BUILDING.md. The hosted xcode-27 image ships
# Xcode 27.2 next to a different default, so CI selects it explicitly.
XCODE_VERSION=27.2
XCODE_APP=/Applications/Xcode_27.2.app

# Must match the gitlink and Patches/OmniGroup/README.md; the bootstrap
# re-checks the gitlink, this copy only keys the submodule object cache.
OMNIGROUP_PIN=2be207ce6f7b4f77498bb48dd5e27403fb689eb7

# The app version (calendar YYYY.M.n) comes from git tags via scripts/release/version.py.
# This xcconfig keeps only documentation and a 0.0.0 fallback; builds inject MARKETING_VERSION.
VERSION_XCCONFIG=GraphSketcher/App/Configurations/Graphink-Version.xcconfig

# git-cliff generates release notes (cliff.toml) at release time and for the in-app notes.
GIT_CLIFF_VERSION=2.14.2
GIT_CLIFF_SHA256_LINUX_X86_64=24f397c733add5390fdceee3a2088588ab0d5f944ce00d34cb7029b888cf2db4
GIT_CLIFF_SHA256_MACOS_ARM64=a0be97e237d440d34c5e508ec21d070b2c85cbb8be48a46a56f9a4e8bd247f05
# Linters run by checks-fast.sh (install-lint-tools.sh). ruff's hashes match its published
# .sha256 files; shellcheck publishes none, so its hashes were taken from the release downloads.
RUFF_VERSION=0.17.5
RUFF_SHA256_LINUX_X86_64=7d261fc981a784668e19e9fa6ad437bfd95b67f2dc263fc1eab87d54d72fcc90
RUFF_SHA256_MACOS_ARM64=4ffadabec5c5fee1ddb2eecac0787ffe6fa18c665b73da9258b84211f40c5829
SHELLCHECK_VERSION=0.11.0
SHELLCHECK_SHA256_LINUX_X86_64=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
SHELLCHECK_SHA256_MACOS_ARM64=56affdd8de5527894dca6dc3d7e0a99a873b0f004d7aabc30ae407d3f48b0a79
# actionlint's hashes match its published actionlint_<version>_checksums.txt.
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256_LINUX_X86_64=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
ACTIONLINT_SHA256_MACOS_ARM64=aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f
# CFBundleVersion of release builds = release workflow run number + this base.
# Raise it (never lower it) if the workflow is renamed and run numbers restart.
BUILD_NUMBER_BASE=0

# Release signing: adhoc (current owner decision: unsigned, not notarized) or
# developer-id (later: needs the secrets listed in docs/CONTRIBUTING-CI.md and
# runs .github/scripts/sign-developer-id.sh).
SIGNING_MODE=adhoc

# Extra xcodebuild settings (comma-separated KEY=value, no spaces) for the
# Release packaging build in adhoc mode only. An ad-hoc app with Hardened
# Runtime aborts at launch (library validation rejects its ad-hoc frameworks),
# and Xcode injects get-task-allow into ad-hoc signatures; these overrides
# remove both and keep the original Release entitlements. developer-id mode
# ignores them and re-signs with Hardened Runtime instead.
RELEASE_DISTRIBUTION_SETTINGS=ENABLE_HARDENED_RUNTIME=NO,CODE_SIGN_INJECT_BASE_ENTITLEMENTS=NO
