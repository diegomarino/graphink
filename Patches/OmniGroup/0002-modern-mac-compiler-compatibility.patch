 RCS_ID("$Id$")
 
+// Feed equivalent cubic control points to the existing geometry and serialization algorithms.
+static NSInteger OACubicPathElementAtIndex(NSBezierPath *path, NSInteger index, NSPoint *points)
+{
+    NSInteger element = [path elementAtIndex:index associatedPoints:points];
+    if (@available(macOS 14.0, *)) {
+        if (element != NSBezierPathElementQuadraticCurveTo)
+            return element;
+        NSPoint control = points[0], end = points[1], start = NSZeroPoint;
+        BOOL afterClose = NO, found = NO;
+        for (NSInteger previous = index - 1; previous >= 0; previous--) {
+            NSPoint prior[3];
+            NSInteger type = [path elementAtIndex:previous associatedPoints:prior];
+            if (type == NSBezierPathElementClosePath) {
+                afterClose = YES;
+                continue;
+            }
+            if (afterClose && type != NSBezierPathElementMoveTo)
+                continue;
+            start = prior[type == NSBezierPathElementCurveTo ? 2 : (type == NSBezierPathElementQuadraticCurveTo ? 1 : 0)];
+            found = YES;
+            break;
+        }
+        if (!found)
+            [NSException raise:NSInternalInconsistencyException format:@"Quadratic segment %ld has no current point", (long)index];
+        points[0] = NSMakePoint(start.x + (control.x - start.x) * (2.0 / 3.0), start.y + (control.y - start.y) * (2.0 / 3.0));
+        points[1] = NSMakePoint(end.x + (control.x - end.x) * (2.0 / 3.0), end.y + (control.y - end.y) * (2.0 / 3.0));
+        points[2] = end;
+        return NSBezierPathElementCurveTo;
+    }
+    return element;
+}
+
